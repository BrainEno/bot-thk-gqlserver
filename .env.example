# Copy to .env for local Docker Compose use. Replace every example secret before deployment.
NODE_ENV=development
PORT=4001
CLIENT_URL=http://localhost:3000
SITE_NAME=BOT THK

MONGODB_URI=mongodb://127.0.0.1:27017/bot-thk
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret-at-least-32-bytes
JWT_RESET_PASSWORD=replace-with-another-long-random-secret-at-least-32-bytes

SENDGRID_API_KEY=
EMAIL_FROM=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_NAME=
