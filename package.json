{
  "name": "gql-server",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "@graphql-tools/utils": "12.1.0"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register src/server.ts",
    "debug": "node --inspect=127.0.0.1:9229 -r ts-node/register src/server.ts",
    "watch": "tsc --project tsconfig.json --watch",
    "build": "tsc --project tsconfig.build.json",
    "start": "node build/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node --test -r ts-node/register test/*.spec.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@apollo/utils.keyvaluecache": "^4.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@sendgrid/mail": "^8.1.6",
    "@typegoose/typegoose": "13.5.0",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-scalars": "2.0.1",
    "graphql-sse": "^2.6.4",
    "graphql-subscriptions": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "9.13.1",
    "pino": "^10.4.0",
    "puppeteer": "^25.19.0",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-rc.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.4",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "pino-pretty": "^13.2.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
