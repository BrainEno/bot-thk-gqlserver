{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug BOT THK GraphQL API",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--inspect-brk=127.0.0.1:9229",
                "-r",
                "ts-node/register"
            ],
            "program": "${workspaceFolder}/src/server.ts",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        }
    ]
}
